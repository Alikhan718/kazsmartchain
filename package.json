{
  "name": "kazsmartchain",
  "version": "1.0.0",
  "description": "KazSmartChain - Sovereign Blockchain for Kazakhstan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "deploy:ksc": "hardhat run scripts/deploy-ksc-token.js --network besu",
    "test:ksc": "hardhat run scripts/test-ksc-token.js --network besu",
    "mint:orgs": "hardhat run scripts/mint-for-organizations.js --network besu",
    "mint:direct": "hardhat run scripts/mint-direct.js --network besu",
    "check:contract": "hardhat run scripts/check-contract-exists.js --network besu",
    "check:balance": "hardhat run scripts/check-ksc-balance.js --network besu",
    "restore:ksc": "hardhat run scripts/restore-ksc-state.js --network besu",
    "compile": "hardhat compile"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.4",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.11",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.4.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "axios": "^1.13.5",
    "chai": "^4.5.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.1.10",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "0.8.17",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@nestjs/swagger": "11.2.6",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "csurf": "^1.11.0",
    "rxjs": "^7.8.1",
    "rxjs-compat": "^6.6.7"
  }
}
