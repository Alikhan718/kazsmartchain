{
  "name": "kazsmartchain",
  "version": "1.0.0",
  "description": "KazSmartChain - Sovereign Blockchain for Kazakhstan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "deploy:ksc": "hardhat run scripts/deploy-ksc-token.js --network besu",
    "test:ksc": "hardhat run scripts/test-ksc-token.js --network besu",
    "mint:orgs": "hardhat run scripts/mint-for-organizations.js --network besu",
    "mint:direct": "hardhat run scripts/mint-direct.js --network besu",
    "check:contract": "hardhat run scripts/check-contract-exists.js --network besu",
    "check:balance": "hardhat run scripts/check-ksc-balance.js --network besu",
    "restore:ksc": "hardhat run scripts/restore-ksc-state.js --network besu",
    "compile": "hardhat compile"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.27.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.16",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "axios": "^1.13.2"
  }
}
